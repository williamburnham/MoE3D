# The dataset is distributed separately and never committed. Everything under
# data/ is ignored except the empty data/MoE3D_data/ placeholder, so stray
# copies of the data elsewhere in data/ cannot be committed either.
data/*
!data/MoE3D_data/
data/MoE3D_data/*
!data/MoE3D_data/.gitkeep

# The SMPL-H body model is licensed separately (mano.is.tue.mpg.de); never
# commit it, wherever it is put
visualisation/body_models/
**/body_models/
*.pkl

# Builds written by build_dataset.py
dataset_build/*
!dataset_build/.gitkeep

# Python
__pycache__/
*.py[cod]
